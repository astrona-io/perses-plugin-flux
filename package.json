{
  "name": "@astrona-io/perses-plugin-flux",
  "version": "0.3.0",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24",
    "npm": ">=11"
  },
  "scripts": {
    "dev": "rsbuild dev",
    "build": "npm run build-mf && concurrently \"npm:build:*\"",
    "build-mf": "rsbuild build",
    "build:esm": "swc ./src -d dist/lib --strip-leading-paths --config-file .swcrc",
    "build:types": "tsc --project tsconfig.build.json",
    "lint": "oxlint src",
    "lint:fix": "oxlint --fix src",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "cross-env LC_ALL=C TZ=UTC vitest run",
    "type-check": "tsc --noEmit"
  },
  "main": "lib/index.js",
  "module": "lib/index.js",
  "types": "lib/index.d.ts",
  "devDependencies": {
    "@module-federation/rsbuild-plugin": "^2.9.1",
    "@rsbuild/core": "^1.7.6",
    "@rsbuild/plugin-react": "^2.0.0",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.15.43",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^13.5.0",
    "@types/node": "^24.13.3",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.3.0",
    "@types/semver": "^7.8.0",
    "concurrently": "^10.0.5",
    "cross-env": "^7.0.3",
    "jsdom": "^27.0.0",
    "oxfmt": "0.70.0",
    "oxlint": "1.93.0",
    "oxlint-plugin-react-doctor": "0.9.23",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-router-dom": "^6.30.6",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "@emotion/react": "^11.7.1",
    "@emotion/styled": "^11.6.0",
    "@hookform/resolvers": "^5.9.1",
    "@mui/material": "^6.1.10",
    "@perses-dev/client": "^0.55.1",
    "@perses-dev/components": "^0.55.1",
    "@perses-dev/dashboards": "^0.55.1",
    "@perses-dev/explore": "^0.55.1",
    "@perses-dev/plugin-system": "^0.55.1",
    "@perses-dev/spec": "^0.3.0-rc.1",
    "@tanstack/react-query": "^4.39.1",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "echarts": "5.6.0",
    "immer": "^10.1.1",
    "lodash": "^4.17.21",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-hook-form": "^7.87.0",
    "use-resize-observer": "^9.0.0"
  },
  "files": [
    "lib/**/*",
    "__mf/**/*",
    "mf-manifest.json",
    "mf-stats.json"
  ],
  "packageManager": "npm@11.21.2",
  "perses": {
    "metadata": {
      "name": "FluxGitOps",
      "registry": "astrona-io"
    },
    "schemasPath": "schemas",
    "plugins": [
      {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Flux GitOps"
          },
          "name": "FluxGitOpsChart"
        }
      }
    ]
  },
  "description": "Perses plugin: Flux and Flux Operator GitOps panel with a resource tree, dependsOn stages, source chains, inventory, reconcile history and a delete-impact preview",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/astrona-io/perses-plugin-flux.git"
  },
  "homepage": "https://github.com/astrona-io/perses-plugin-flux#readme",
  "bugs": {
    "url": "https://github.com/astrona-io/perses-plugin-flux/issues"
  },
  "keywords": [
    "perses",
    "plugin",
    "flux",
    "fluxcd",
    "flux-operator",
    "gitops",
    "kubernetes",
    "panel"
  ],
  "dependencies": {
    "semver": "^7.8.6",
    "yaml": "^2.9.1"
  }
}
