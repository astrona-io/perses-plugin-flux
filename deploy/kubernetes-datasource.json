{
  "kind": "GlobalDatasource",
  "metadata": {
    "name": "kubernetes"
  },
  "spec": {
    "default": false,
    "plugin": {
      "kind": "KubernetesDatasource",
      "spec": {
        "proxy": {
          "kind": "HTTPProxy",
          "spec": {
            "url": "https://kubernetes.default.svc",
            "secret": "kubernetes-in-cluster",
            "allowedEndpoints": [
              {
                "endpointPattern": "^/api/v1/namespaces$",
                "method": "GET"
              },
              {
                "endpointPattern": "^/api/v1/(namespaces/[a-z0-9]([-a-z0-9]*[a-z0-9])?/)?(pods|events|services|persistentvolumeclaims)$",
                "method": "GET"
              },
              {
                "endpointPattern": "^/apis/apps/v1/(namespaces/[a-z0-9]([-a-z0-9]*[a-z0-9])?/)?(deployments|statefulsets|daemonsets|replicasets)$",
                "method": "GET"
              },
              {
                "endpointPattern": "^/apis/source\\.toolkit\\.fluxcd\\.io/v1/(namespaces/[a-z0-9]([-a-z0-9]*[a-z0-9])?/)?(gitrepositories|ocirepositories|helmrepositories|helmcharts|buckets)$",
                "method": "GET"
              },
              {
                "endpointPattern": "^/apis/kustomize\\.toolkit\\.fluxcd\\.io/v1/(namespaces/[a-z0-9]([-a-z0-9]*[a-z0-9])?/)?kustomizations$",
                "method": "GET"
              },
              {
                "endpointPattern": "^/apis/helm\\.toolkit\\.fluxcd\\.io/v2/(namespaces/[a-z0-9]([-a-z0-9]*[a-z0-9])?/)?helmreleases$",
                "method": "GET"
              },
              {
                "endpointPattern": "^/apis/fluxcd\\.controlplane\\.io/v1/(namespaces/[a-z0-9]([-a-z0-9]*[a-z0-9])?/)?(fluxinstances|fluxreports|resourcesets|resourcesetinputproviders)$",
                "method": "GET"
              },
              {
                "endpointPattern": "^/api/v1/namespaces/[a-z0-9]([-a-z0-9]*[a-z0-9])?/services/source-controller:80/proxy/helmrepository/[a-z0-9]([-a-z0-9]*[a-z0-9])?/[a-z0-9]([-a-z0-9.]*[a-z0-9])?/index-[a-f0-9]+\\.yaml$",
                "method": "GET"
              }
            ]
          }
        }
      }
    }
  }
}
